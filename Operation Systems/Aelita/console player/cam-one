#!/usr/bin/env bash
# cam-one — показ одной RTSP-камеры в небольшом окне (X11/xrdp)
# Зависимости: ffmpeg (ffmpeg, ffprobe)
# Пример: cam-one rtsp://user:pass@192.168.0.71:554/Streaming/Channels/102
set -u

SIZE=640x360
TRANSPORT=tcp
FPS=""
TITLE=""
AUDIO=0
FFARGS=""
URL=""

usage() {
  cat <<'EOF'
cam-one — одна RTSP-камера в окне 640x360 (по умолчанию), не на весь экран

Использование:
  cam-one rtsp://user:pass@IP:554/Streaming/Channels/102
  cam-one --size 960x540 rtsp://...
  cam-one --transport udp "rtsp://IP:554/cam/realmonitor?channel=1&subtype=1"

Опции:
  -s, --size WxH        размер окна, по умолчанию 640x360
  -t, --transport Т     tcp (по умолчанию) или udp — только для rtsp(s)://
  -f, --fps N           ограничить частоту кадров (меньше = легче CPU)
      --title ТЕКСТ     заголовок окна
      --audio           включить звук потока (по умолчанию выключен)
      --ffmpeg-args "…" дополнительные ключи входа ffmpeg, например "-tls_verify 0"
  -h, --help            эта справка

Выход: q в окне или Ctrl+C в терминале.
EOF
}

die() { echo "cam-one: $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  # поддержка формы --опция=значение
  if [[ "$1" == --*=* ]]; then
    set -- "${1%%=*}" "${1#*=}" "${@:2}"
  fi
  case "$1" in
    -s|--size)       SIZE=${2:-}; shift 2 || die "нужен размер WxH" ;;
    -t|--transport)  TRANSPORT=${2:-}; shift 2 || die "нужен транспорт tcp|udp" ;;
    -f|--fps)        FPS=${2:-}; shift 2 || die "нужно число fps" ;;
    --title)         TITLE=${2:-}; shift 2 || die "нужен текст заголовка" ;;
    --audio)         AUDIO=1; shift ;;
    --ffmpeg-args)   FFARGS=${2:-}; shift 2 || die "нужна строка ключей ffmpeg" ;;
    -h|--help)       usage; exit 0 ;;
    -*)              die "неизвестная опция: $1 (см. --help)" ;;
    *)
      [ -z "$URL" ] || die "лишний аргумент: $1 (нужна одна ссылка на поток)"
      URL=$1; shift ;;
  esac
done

[ -n "$URL" ] || { usage >&2; die "не задана ссылка на поток"; }
[[ "$URL" == *'://'* ]] || die "ожидается URL вида rtsp://…, получено: $URL"
[[ "$SIZE" =~ ^[0-9]+x[0-9]+$ ]] || die "некорректный размер: $SIZE (нужно WxH, например 640x360)"
[ -n "$FPS" ] && { [[ "$FPS" =~ ^[0-9]+$ ]] && [ "$FPS" -ge 1 ] || die "некорректный fps: $FPS"; }
[ -n "${DISPLAY:-}" ] || die "DISPLAY не задан (запускайте из графического сеанса)"
command -v ffmpeg >/dev/null 2>&1 || die "не найден ffmpeg (dnf -y install ffmpeg)"

w=${SIZE%x*}; h=${SIZE#*x}
[ $((w % 2)) -eq 0 ] || w=$((w - 1))
[ $((h % 2)) -eq 0 ] || h=$((h - 1))
SIZE="${w}x${h}"

mask() { printf '%s' "$1" | sed -E 's#(//[^:/@]+):[^@/]*@#\1:***@#'; }

if [ -z "$TITLE" ]; then
  TITLE="cam-one — $(mask "$URL")"
  [ ${#TITLE} -gt 90 ] && TITLE="${TITLE:0:87}…"
fi

filter="scale=$w:$h:force_original_aspect_ratio=decrease,pad=$w:$h:(ow-iw)/2:(oh-ih)/2,setsar=1,format=yuv420p"
[ -n "$FPS" ] && filter="fps=$FPS,$filter"

args=(-hide_banner -loglevel warning -nostats
      -fflags nobuffer -flags low_delay -thread_queue_size 512
      -analyzeduration 1000000 -probesize 1000000)

case "$URL" in
  rtsp://*|rtsps://*) args+=(-rtsp_transport "$TRANSPORT") ;;
esac

if [ -n "$FFARGS" ]; then
  read -r -a _extra <<<"$FFARGS"
  args+=("${_extra[@]}")
fi

args+=(-i "$URL" -vf "$filter")
[ "$AUDIO" = 1 ] || args+=(-an)
args+=(-f sdl2 -window_title "$TITLE" -window_size "$SIZE" -window_borderless 0 -window_enable_quit 1 sdl2out)

echo "cam-one: $SIZE, $(mask "$URL")" >&2
exec ffmpeg "${args[@]}"
